# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
backend/.venv/
backend/data/
backend/data/outputs/*
!backend/data/outputs/.gitkeep
*.db
*.sqlite3

# --- env / secrets ---
.env
backend/.env
*.env.local

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
*.tsbuildinfo

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- audio output artifacts (generated at runtime) ---
*.wav
*.mp3
*.flac
!frontend/public/**/*.mp3
