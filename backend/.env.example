# ==============================================================
# 認知機能サポートBGM AI - 環境変数設定サンプル
# このファイルを .env にコピーして値を設定してください。
#   cp .env.example .env
# .env は絶対にGitにコミットしないでください（.gitignore済み）。
# ==============================================================

# 使用する音楽生成プロバイダー
# procedural   : APIキー不要。ローカルでBGMを自動作曲・生成します（デフォルト・動作確認済み）
# elevenlabs   : ElevenLabs Music API を使用（要 ELEVENLABS_API_KEY）
# stability    : Stability AI Audio API を使用（要 STABILITY_API_KEY）
DEFAULT_MUSIC_PROVIDER=procedural

# --- 外部AI音楽生成サービスのAPIキー（任意） ---
# 未設定でもソフトウェアは procedural プロバイダーで正常に動作します。
ELEVENLABS_API_KEY=
STABILITY_API_KEY=

# --- サーバー設定 ---
HOST=0.0.0.0
PORT=8000

# フロントエンド開発サーバーのオリジン（CORS許可）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- データ保存先 ---
DATA_DIR=./data
OUTPUT_DIR=./data/outputs
DB_PATH=./data/projects.db

# --- ログレベル ---
LOG_LEVEL=INFO
